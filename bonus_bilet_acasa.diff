+            date(2026, 9, 7),
+            leave_summary={"remaining_days": f"{ZILE_CONCEDIU_NECESARE_BILET:.2f}"},
+        )
+
+        self.assertTrue(result["has_enough_leave_days"])
+
+    def test_negative_leave_balance_is_reported_as_is(self):
